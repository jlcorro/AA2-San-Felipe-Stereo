# URL pública del streaming de San Felipe Stereo (https recomendado).
# Ejemplo de forma: https://servidor.ejemplo.com:8000/stream
# Las variables VITE_* son visibles en el navegador: no pongas secretos aquí.
VITE_RADIO_STREAM_URL=

# (Opcional) Endpoint de un servicio de formularios (p. ej. Formspree) que reciba POST con JSON.
# Si se deja vacío, el formulario explica que falta integración y ofrece el correo.
VITE_FORM_ENDPOINT=
